# PostgreSQL connection string (Render, Railway, Neon, Supabase all give you one).
DATABASE_URL=postgresql://ashwheelz:change-me@localhost:5432/ashwheelz
# Optional: direct (non-pooled) URL used only to create tables. Neon on Vercel sets this.
# DATABASE_URL_UNPOOLED=


# Required. Long random string, the same on every server. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# First admin account, created only when no admin exists yet.
# Change the password from the dashboard after the first sign-in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234

# Keep true in production (HTTPS). Set false only for local http://localhost testing.
COOKIE_SECURE=true

# Dates in the dashboard filters and Excel export use this time zone.
APP_TIMEZONE=Asia/Karachi

SESSION_HOURS=12
